# Plantilla de variables de entorno - copia este archivo como .env.local y rellena.
# IMPORTANTE: en una app Vite pura (sin backend), TODO lo que tenga prefijo VITE_
# queda visible en el bundle del navegador. No pongas claves sensibles de producción.

# Clave de prueba del servicio externo
VITE_API_KEY=

# URL base del servicio (ejemplo)
VITE_API_BASE_URL=
